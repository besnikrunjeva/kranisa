DATABASE_URL=postgres://localhost:5432/kranisa
PORT=4000
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=
JWT_SECRET=change-me

# Planner LLM provider (optional). If GLM_API_KEY is set, the planner uses
# z.ai GLM; otherwise it falls back to local Ollama, then the scripted engine.
GLM_API_KEY=
GLM_MODEL=glm-5.3-flash
GLM_BASE_URL=https://api.z.ai/api/paas/v4
